{
  "name": "bot-game-mcp-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "QQ 群聊桌游引擎（MCP）工作区：引擎 bot-game-mcp、代码裁判 bot-game-mcp-referee-onebot、接入端 bot-game-mcp-agent-kit",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/engine",
    "packages/referee-onebot",
    "packages/agent-kit"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "npm run docs -w bot-game-mcp",
    "simulate": "npm run simulate -w bot-game-mcp --",
    "e2e": "tsx scripts/e2e.ts",
    "load": "tsx scripts/load.ts",
    "world:simulate": "tsx scripts/world-simulate.ts",
    "world:load": "tsx scripts/world-load.ts",
    "world:recovery": "tsx scripts/world-recovery.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gengetau/bot-game-mcp.git"
  }
}
